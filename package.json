{
  "name": "repo-access-sharer",
  "version": "1.0.0",
  "description": "Receives Mia-Platform Console service_created webhooks and shares the new GitLab repository with a configured group",
  "main": "index.js",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node index.js",
    "lint": "eslint .",
    "unit": "node --test \"test/**/*.test.js\"",
    "checkonly": "! grep -RE \"\\.only\\(|only: true\" test/",
    "test": "npm run lint && npm run unit && npm run checkonly",
    "coverage": "c8 --reporter=text-summary --reporter=cobertura --reporter=lcov node --test \"test/**/*.test.js\"",
    "send-test-webhook": "node scripts/send-test-webhook.js"
  },
  "dependencies": {
    "fastify": "^5.2.1"
  },
  "devDependencies": {
    "c8": "^12.0.0",
    "eslint": "^9.39.5",
    "neostandard": "^0.14.1"
  }
}
